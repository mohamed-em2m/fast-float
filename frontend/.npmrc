# pnpm keeps a content-addressable store (default: ~/.local/share/pnpm/store)
# and hardlinks packages into node_modules, so repeat installs reuse what is
# already on disk instead of downloading and extracting the same tarballs
# again. Prefer that cache over a registry round-trip when it is available.
prefer-offline=true

# The repo used to be installed with npm. When pnpm meets that node_modules it
# wants to replace it; never block an unattended setup waiting for a prompt.
confirm-modules-purge=false
