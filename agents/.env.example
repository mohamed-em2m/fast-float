# Copy to agents/.env (never commit it).

# --- LiveKit SFU -----------------------------------------------------------
# Same project/keys the FLOAT API uses. ws:// for a local server, wss:// for
# LiveKit Cloud or a TLS-terminated deployment.
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecretdevsecretdevsecretdevsecret

# --- Gemini Live API -------------------------------------------------------
# GOOGLE_API_KEY is what google-genai reads; GEMINI_API_KEY also works.
GOOGLE_API_KEY=
# Leave empty to use the plugin's current stable Gemini Live model.
# GEMINI_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
GEMINI_VOICE=Puck
# Optional BCP-47 language hint, e.g. en-US.
GEMINI_LANGUAGE=

# Vertex AI instead of the Gemini Developer API:
# GOOGLE_GENAI_USE_VERTEXAI=1
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1

# --- FLOAT integration -----------------------------------------------------
# The avatar participant FLOAT connects to this room. Must match the API's
# FLOAT_AVATAR_IDENTITY.
FLOAT_AVATAR_IDENTITY=float-avatar
# Agent name registered with LiveKit; the FLOAT API dispatches this name.
FLOAT_GEMINI_AGENT_NAME=float-gemini
# Where the voice tools call the FLOAT HTTP API.
FLOAT_API_URL=http://127.0.0.1:8000
FLOAT_API_TIMEOUT_S=8
