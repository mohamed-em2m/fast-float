# Copy to agents/.env (never commit it).
#
# ONE SOURCE OF TRUTH: the shared FLOAT config (fast_float/config/secerts.toml
# for secrets, settings.toml for defaults) is read by both the API and this
# worker and WINS over everything below. Put deployment values (LiveKit
# url/key/secret, Gemini key/model, agent name) there, not here — a differing
# copy here is silently ignored (with a warning) and can register this worker
# on the wrong LiveKit project.
#
# Keep values in this file only for a box without the shared config.

# --- LiveKit SFU -----------------------------------------------------------
# Same project/keys the FLOAT API uses. ws:// for a local server, wss:// for
# LiveKit Cloud or a TLS-terminated deployment.
# PREFERRED: [livekit] in fast_float/config/secerts.toml
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecretdevsecretdevsecretdevsecret

# --- Gemini Live API -------------------------------------------------------
# PREFERRED: [gemini].api_key in fast_float/config/secerts.toml — one key
# serves both the API and this worker.
# GOOGLE_API_KEY is what google-genai reads; GEMINI_API_KEY also works.
GOOGLE_API_KEY=
# Leave empty to use the plugin's current stable Gemini Live model.
# GEMINI_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
GEMINI_VOICE=Puck
# Optional BCP-47 language hint, e.g. en-US.
GEMINI_LANGUAGE=

# Vertex AI instead of the Gemini Developer API:
# GOOGLE_GENAI_USE_VERTEXAI=1
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1

# --- FLOAT integration -----------------------------------------------------
# The avatar participant FLOAT connects to this room. Must match the API's
# FLOAT_AVATAR_IDENTITY. PREFERRED: [gemini].avatar_identity in
# fast_float/config/settings.toml.
FLOAT_AVATAR_IDENTITY=float-avatar
# Agent name registered with LiveKit; the FLOAT API dispatches this name.
# PREFERRED: [gemini].agent_name in fast_float/config/settings.toml.
FLOAT_GEMINI_AGENT_NAME=float-gemini
# Where the voice tools call the FLOAT HTTP API.
FLOAT_API_URL=http://127.0.0.1:8000
FLOAT_API_TIMEOUT_S=8
