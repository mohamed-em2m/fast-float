# Set default behavior to automatically normalize line endings
* text=auto

# Explicitly declare text files you want to always be normalized and converted
# to native line endings on checkout.
*.py text
*.json text
*.yaml text
*.yml text
*.toml text
*.md text
*.js text
*.jsx text
*.ts text
*.tsx text
*.css text
*.html text

# Shell scripts and configurations must always have LF line endings
*.sh text eol=lf
*.bash text eol=lf
.shellcheckrc text eol=lf
tools/pre_commit/.shellcheckrc text eol=lf

# Denote all binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pth binary
*.onnx binary
*.engine binary
*.plan binary
