# Copy to .env (never commit it). This is an OPTIONAL fallback: the shared
# FLOAT config is the single source of truth and WINS over these values:
#
#   fast_float/config/secerts.toml  -> secrets ([livekit], [gemini].api_key)
#   fast_float/config/settings.toml -> defaults ([livekit], [gemini], [webrtc])
#
# Both the API and the Gemini worker read those files. A differing copy here
# is ignored with a warning and can register the worker on the wrong LiveKit
# project. Keep values here only for a box without the shared config.
#
# run_all.sh passes this file to the API (uv --env-file); the worker loads it
# with python-dotenv.

# --- Shared config directory ----------------------------------------------
# Point both processes at the same checkout when it is not the default
# fast_float/config next to this project. Prefer an absolute path.
# FLOAT_CONFIG_DIR=/abs/path/to/float-fast/fast_float/config

# --- LiveKit SFU -----------------------------------------------------------
# Same project/keys the FLOAT API uses. ws:// for a local server, wss:// for
# LiveKit Cloud or a TLS-terminated deployment.
# PREFERRED: [livekit] in fast_float/config/secerts.toml
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecretdevsecretdevsecretdevsecret

# --- Gemini Live API -------------------------------------------------------
# PREFERRED: [gemini].api_key in fast_float/config/secerts.toml — one key
# serves both the API and the worker.
# GOOGLE_API_KEY is what google-genai reads; GEMINI_API_KEY also works.
GOOGLE_API_KEY=
# Leave empty to use the plugin's current stable Gemini Live model.
# GEMINI_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
GEMINI_VOICE=Puck
# Optional BCP-47 language hint, e.g. en-US.
GEMINI_LANGUAGE=

# Vertex AI instead of the Gemini Developer API:
# GOOGLE_GENAI_USE_VERTEXAI=1
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1

# --- FLOAT integration -----------------------------------------------------
# The avatar participant FLOAT connects to this room. Must match the API's
# FLOAT_AVATAR_IDENTITY. PREFERRED: [gemini].avatar_identity in
# fast_float/config/settings.toml.
FLOAT_AVATAR_IDENTITY=float-avatar
# Agent name registered with LiveKit; the FLOAT API dispatches this name.
# PREFERRED: [gemini].agent_name in fast_float/config/settings.toml.
FLOAT_GEMINI_AGENT_NAME=float-gemini
# Where the voice tools call the FLOAT HTTP API.
FLOAT_API_URL=http://127.0.0.1:8000
FLOAT_API_TIMEOUT_S=8
# Optional env fallback; prefer prompts/gemini_agent.md via
# [gemini].instructions_file in settings.toml.
# FLOAT_AGENT_INSTRUCTIONS=

# --- Launcher --------------------------------------------------------------
# run_all.sh: auto (default) starts the worker when LiveKit + Gemini are
# configured; yes requires it; no skips it.
# FLOAT_GEMINI_WORKER=auto
